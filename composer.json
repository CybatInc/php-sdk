{
    "name": "cybat/sdk",
    "description": "Cybat SDK for PHP -- PSR-15 middleware that reports HTTP traffic directly to the Cybat Intelligence Engine",
    "type": "library",
    "license": "MIT",
    "homepage": "https://cybat.co",
    "require": {
        "php": "^8.1",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-server-handler": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Cybat\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cybat\\Sdk\\Tests\\": "tests/"
        }
    }
}
